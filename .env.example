# Synapse Nexus — local dev environment template.
#
# Copy this file to `.env` and fill in your own credentials:
#     cp .env.example .env
#
# `.env` is gitignored — it must NEVER be committed.
# Tools like `direnv` will load this automatically; otherwise:
#     set -a; source .env; set +a
#     cargo run -p synapse-daemon

# ---- ASR provider selection ---------------------------------------------
# One of: mock | streaming_ws | doubao
# Defaults to "mock" for first-run demo with no credentials needed.
SYNAPSE_ASR_PROVIDER=mock

# ---- Provider: streaming_ws (any v0 JSON ASR backend) -------------------
# SYNAPSE_ASR_ENDPOINT=wss://your-asr.example.com/v0
# SYNAPSE_ASR_TOKEN=

# ---- Provider: doubao (Volc Engine bigmodel streaming ASR) --------------
# Endpoint defaults to wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# SYNAPSE_DOUBAO_ENDPOINT=
#
# Volc ARK API key — starts with "ark-". Treat like a password.
# Get one at https://console.volcengine.com/ark
# SYNAPSE_DOUBAO_API_KEY=ark-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
#
# Optional: Volc app id / resource id (some endpoint variants require it).
# SYNAPSE_DOUBAO_APP_ID=

# ---- Logging ------------------------------------------------------------
# RUST_LOG=synapse=debug,synapsed=debug,info

# ---- Polish (LLM post-processing) provider ------------------------------
# When configured, the daemon runs every ASR Final through this LLM with
# a 600ms budget. On timeout / audit reject / provider error the daemon
# falls back to the raw ASR result — never blocks the user.
#
# SYNAPSE_POLISH_PROVIDER=qwen          # or "none"
# SYNAPSE_POLISH_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# # Or for Volc ARK chat completions:
# # SYNAPSE_POLISH_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# SYNAPSE_POLISH_API_KEY=
# SYNAPSE_POLISH_MODEL=qwen-flash       # or "doubao-pro-4k", etc
